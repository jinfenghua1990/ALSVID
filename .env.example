# Example variable names only. Do not use this file as proof of production connectivity.
# All business deployments must use the existing production services and data.
# Supply values via authorized secret management; never commit real credentials.
NODE_ENV=production
# Set only after verifying the actual service and data bindings.
ALSVID_ENV=
WEB_PORT=3000
API_PORT=4000
# Set to the verified current production API base URL before running the web app.
ALSVID_API_BASE_URL=
# Optional fixture preview for My ALSVID only; ignored outside development.
ALSVID_DEV_OPEN_PORTAL=0

# Password login is scoped per internal portal; My ALSVID remains email-code only.
ALSVID_ADMIN_PASSWORD_LOGIN_ENABLED=true
ALSVID_DEALER_PASSWORD_LOGIN_ENABLED=true
ALSVID_SUPPLIER_PASSWORD_LOGIN_ENABLED=true
# Obtain the existing production database connection from authorized secret storage.
DATABASE_URL=

# Legacy/emergency bootstrap path. Prefer verified company-email activation.
ALSVID_BOOTSTRAP_ADMIN_EMAIL=admin@example.com
ALSVID_BOOTSTRAP_ADMIN_PASSWORD=
ALSVID_BOOTSTRAP_ADMIN_NAME=ALSVID Administrator

# Internal identity policy. Separate multiple domains with semicolons.
ALSVID_INTERNAL_EMAIL_DOMAINS=company.example
ALSVID_INTERNAL_REGISTRATION_MODE=company_domain
ALSVID_INITIAL_ADMIN_EMAIL=admin@company.example
# Development/Test only. Never enable in Production.
ALSVID_EMAIL_TEST_MODE=false

# Configure the existing production R2 binding through authorized secret storage.
OBJECT_STORAGE_PROVIDER=r2
OBJECT_STORAGE_ENDPOINT=
OBJECT_STORAGE_REGION=auto
OBJECT_STORAGE_BUCKET=
OBJECT_STORAGE_ACCESS_KEY=
OBJECT_STORAGE_SECRET_KEY=
OBJECT_STORAGE_PUBLIC_BASE_URL=
SHOPIFY_SHOP_DOMAIN=
SHOPIFY_ACCESS_TOKEN=

# MAIL_PROVIDER supports console (local development only) or resend.
MAIL_PROVIDER=
MAIL_FROM_ADDRESS=
MAIL_API_KEY=

# Optional published Shopify product URL for the ALSVID FC1 purchase handoff
ALSVID_SHOPIFY_FC1_PRODUCT_URL=

# Optional FC1 email-reservation recipient. Set before the Next.js production build.
# When empty, the reservation CTA stays visibly disabled and no address is invented.
NEXT_PUBLIC_FC1_RESERVATION_EMAIL=
