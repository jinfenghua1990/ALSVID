ALSVID_ENVIRONMENT=development
ALSVID_HOST=127.0.0.1
ALSVID_PORT=8200
ALSVID_DATABASE_URL=postgresql+psycopg://alsvid:alsvid@127.0.0.1:5432/alsvid

# Authentication. Keep production cookies secure.
ALSVID_SESSION_COOKIE_NAME=alsvid_session
ALSVID_SESSION_TTL_HOURS=12
ALSVID_SESSION_COOKIE_SECURE=false
ALSVID_PASSWORD_MIN_LENGTH=12
ALSVID_AUTH_LOCKOUT_ATTEMPTS=5
ALSVID_AUTH_LOCKOUT_MINUTES=15

# Object storage. Keep live credentials outside Git.
ALSVID_R2_ENDPOINT_URL=
ALSVID_R2_BUCKET=
ALSVID_R2_ACCESS_KEY_ID=
ALSVID_R2_SECRET_ACCESS_KEY=
ALSVID_R2_REGION=auto
ALSVID_R2_PUBLIC_BASE_URL=
ALSVID_R2_PRESIGN_SECONDS=900
