{
  "name": "@alsvid/api",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --env-file-if-exists=../../.env node_modules/tsx/dist/cli.mjs watch src/main.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "tsc -p tsconfig.json --noEmit",
    "test": "node --import tsx --test src/*.test.mjs test/*.test.ts",
    "bootstrap:admin": "tsx src/bootstrap-admin.ts"
  },
  "dependencies": {
    "@alsvid/assets": "workspace:*",
    "@alsvid/audit": "workspace:*",
    "@alsvid/commerce": "workspace:*",
    "@alsvid/database": "workspace:*",
    "@alsvid/dealer": "workspace:*",
    "@alsvid/engineering": "workspace:*",
    "@alsvid/finance": "workspace:*",
    "@alsvid/identity": "workspace:*",
    "@alsvid/integrations": "workspace:*",
    "@alsvid/inventory": "workspace:*",
    "@alsvid/kernel": "workspace:*",
    "@alsvid/logistics": "workspace:*",
    "@alsvid/observability": "workspace:*",
    "@alsvid/partners": "workspace:*",
    "@alsvid/ports": "workspace:*",
    "@alsvid/procurement": "workspace:*",
    "@alsvid/product": "workspace:*",
    "@alsvid/production": "workspace:*",
    "@alsvid/provider-adapters": "workspace:*",
    "@alsvid/service": "workspace:*",
    "@alsvid/vehicle": "workspace:*",
    "@alsvid/warehouse": "workspace:*",
    "@nestjs/common": "^12.0.0",
    "@nestjs/core": "^12.0.0",
    "@nestjs/platform-fastify": "^12.0.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tsx": "^4.20.0",
    "typescript": "^6.0.0"
  }
}
