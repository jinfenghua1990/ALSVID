# ALSVID Development/Test Environment
NODE_ENV=test

DATABASE_URL=postgresql://alsvid_test:alsvid_test@postgres:5432/alsvid_test

# Object-storage provider acceptance is tracked in Issue #35. Core runtime smoke
# tests intentionally do not require a storage emulator before that adapter exists.
OBJECT_STORAGE_PROVIDER=unconfigured

WEB_PORT=3001
API_PORT=4001
ALSVID_API_BASE_URL=http://api:4000
