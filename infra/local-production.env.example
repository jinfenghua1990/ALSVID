# Copy to infra/.env.local (already ignored by Git).
# Public NON-SECRET settings only; credentials are fetched on every "up"
# from the existing Google Secret Manager used by Cloud Run.
# Verify the active Cloud Run project/region and production R2 configuration.
GCP_PROJECT_ID=
GCP_REGION=europe-west1
OBJECT_STORAGE_ENDPOINT=
OBJECT_STORAGE_BUCKET=
MAIL_FROM_ADDRESS=noreply@alsvidbike.com
NEXT_PUBLIC_FC1_RESERVATION_EMAIL=info@alsvidbike.com
ALSVID_INTERNAL_EMAIL_DOMAINS=
ALSVID_INTERNAL_REGISTRATION_MODE=company_domain
ALSVID_INITIAL_ADMIN_EMAIL=
