# ALSVID production runtime template
#
# This file contains names/placeholders only. Do not commit real credentials.
# Production secret values are supplied by Google Cloud Secret Manager.

NODE_ENV=production

# Password login is scoped per internal portal; My ALSVID remains email-code only.
ALSVID_ADMIN_PASSWORD_LOGIN_ENABLED=false
ALSVID_DEALER_PASSWORD_LOGIN_ENABLED=false
ALSVID_SUPPLIER_PASSWORD_LOGIN_ENABLED=false

# Neon managed PostgreSQL. Runtime value comes from Secret Manager secret:
#   alsvid-database-url
DATABASE_URL=__FROM_SECRET_MANAGER__

# Cloudflare R2 / S3-compatible object storage.
OBJECT_STORAGE_PROVIDER=r2
OBJECT_STORAGE_ENDPOINT=https://<cloudflare-account-id>.r2.cloudflarestorage.com
OBJECT_STORAGE_REGION=auto
OBJECT_STORAGE_BUCKET=alsvid-production
# Runtime values come from Secret Manager secrets:
#   alsvid-r2-access-key
#   alsvid-r2-secret-key
OBJECT_STORAGE_ACCESS_KEY=__FROM_SECRET_MANAGER__
OBJECT_STORAGE_SECRET_KEY=__FROM_SECRET_MANAGER__

# API_PORT remains useful outside Cloud Run. Cloud Run services inject PORT.
API_PORT=4000

# Local/CI worker scaffold settings only; production does not deploy a Worker Pool.
WORKER_ID=alsvid-worker-production
WORKER_QUEUE=default
WORKER_POLL_MS=1000
WORKER_LEASE_MS=300000

# Transactional mail. The API key is supplied by Secret Manager.
MAIL_PROVIDER=resend
# Use only after alsvidbike.com has been verified as a sender domain in the mail provider.
MAIL_FROM_ADDRESS=noreply@alsvidbike.com
MAIL_FROM_NAME=ALSVID
AUTH_BASE_URL=https://admin.alsvidbike.com
MAIL_API_KEY=__FROM_SECRET_MANAGER__

# Provider-neutral AI configuration. Credentials belong in Secret Manager and
# provider adapters are selected separately from production runtime packaging.
AI_PROVIDER=
AI_DEFAULT_MODEL=
